            "unique": true,
            "customField": "plugin::tenant-select.tenant"
        },
        "heroTitle": {
            "type": "string"
        },
        "heroHighlight": {
            "type": "string"
        },
        "heroSubtitle": {
            "type": "text"
        },
        "heroDescription": {
            "type": "text"
        },
        "heroCtaLabel": {
            "type": "string"
        },
        "heroCtaHref": {
            "type": "string"
        },
        "featuresTitle": {
            "type": "string"
        },
        "featuresSubtitle": {
            "type": "string"
        },
        "features": {
            "type": "component",
            "repeatable": true,
            "component": "shared.feature"
        },
        "ctaTitle": {
            "type": "string"
        },
        "ctaHighlight": {
            "type": "string"
        },
        "ctaSubtitle": {
            "type": "text"
        },
        "ctaDescription": {
            "type": "text"
        },
        "ctaPrimaryLabel": {
            "type": "string"
        },
        "ctaPrimaryHref": {
            "type": "string"
        },
        "ctaSecondaryLabel": {
            "type": "string"
        },
        "ctaSecondaryHref": {
            "type": "string"
        },
        "newsletterTitle": {
            "type": "string"
        },
        "newsletterSubtitle": {
            "type": "text"
        },
        "footerDescription": {
            "type": "text"
        },
        "servicesTitle": {
            "type": "string"
        },
        "servicesBadge": {
            "type": "string",
            "default": "Qué ofrecemos"
        },
        "servicesSubtitle": {
            "type": "text"
        },
        "bookingHeroTitle": {
            "type": "string"
        },
        "bookingHeroHighlight": {
            "type": "string"
        },
        "bookingHeroSubtitle": {
            "type": "text"
        },
        "bookingCtaLabel": {
            "type": "string"
        },
        "bookingCtaHref": {
            "type": "string"
        },
        "socialLinks": {
            "type": "component",
            "repeatable": true,
            "component": "shared.social-link"
        }
