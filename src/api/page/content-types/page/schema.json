{
    "kind": "collectionType",
    "collectionName": "pages",
    "info": {
        "singularName": "page",
        "pluralName": "pages",
        "displayName": "Page",
        "description": "Static pages (about, faq, contact, privacy, terms, careers) per tenant"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "tenantId": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "string",
            "required": true
        },
        "title": {
            "type": "string"
        },
        "blocks": {
            "type": "dynamiczone",
            "components": [
                "shared.rich-text",
                "shared.faq-item"
            ]
        }
    }
}
